{
  "version": "1.3.0",
  "identifier_pattern": "^(?!\\.+$)[a-z0-9._-]+$",
  "roles": {
    "manager": ["99_generic_workstream_manager"],
    "coding": ["01_opencode_config", "04_legacy_coding", "05_ml_coding", "06_ki_demo_coding", "99_generic_coding"],
    "config": ["01_opencode_config_alt", "01_opencode_sync_config", "02_nvim_config", "03_dotfiles_config", "99_generic_config", "99_generic_plannotator_config"],
    "cleanup": ["99_generic_WS_CLEANUP_GIT_MANAGER"],
    "repair": ["99_generic_WS_HISTORY_REPAIR_GIT_MANAGER"],
    "group_git": ["99_generic_WS_GROUP_GIT_MANAGER"]
  },
  "actions": {
    "list": {"family": "list", "phase": "read", "args": [], "mutates": false, "roles": ["manager"], "argv": ["list"]},
    "sessions": {"family": "sessions", "phase": "read", "args": ["slug"], "mutates": false, "roles": ["manager"], "argv": ["sessions", "{slug}"]},
    "new": {"family": "new", "phase": "apply", "args": ["slug"], "mutates": true, "roles": ["manager"], "argv": ["new", "{slug}", "--", "true"]},
    "resume": {"family": "resume", "phase": "apply", "args": ["slug"], "mutates": true, "roles": ["manager"], "argv": ["resume", "{slug}", "--", "true"]},
    "group_new": {"family": "group_new", "phase": "apply", "args": ["group_id", "members?"], "mutates": true, "roles": ["manager"], "argv": ["group-new", "{group_id}", "{members}"]},
    "member_new": {"family": "member_new", "phase": "apply", "args": ["group_id", "slug"], "mutates": true, "roles": ["manager"], "argv": ["member-new", "{group_id}", "{slug}"]},
    "member_adopt": {"family": "member_adopt", "phase": "apply", "args": ["group_id", "slug"], "mutates": true, "roles": ["manager"], "argv": ["member-adopt", "{group_id}", "{slug}"]},
    "finish_preview": {"family": "finish", "phase": "preview", "args": ["slug"], "mutates": false, "roles": ["coding", "config", "cleanup"], "argv": ["finish", "{slug}"]},
    "finish_apply": {"family": "finish", "phase": "apply", "args": ["slug"], "mutates": true, "token": "preview", "roles": ["coding", "config", "cleanup"], "argv": ["finish", "{slug}", "--apply", "--preview-token", "{preview_token}"]},
    "sync_preview": {"family": "sync", "phase": "preview", "args": ["slug"], "mutates": false, "roles": ["coding", "config", "cleanup"], "argv": ["sync", "{slug}"]},
    "sync_apply": {"family": "sync", "phase": "apply", "args": ["slug"], "mutates": true, "token": "preview", "roles": ["coding", "config", "cleanup"], "argv": ["sync", "{slug}", "--apply", "--preview-token", "{preview_token}"]},
    "sync_push": {"family": "sync", "phase": "push", "args": ["slug"], "mutates": true, "token": "push", "roles": ["coding", "config", "cleanup"], "argv": ["sync", "{slug}", "--push", "--push-token", "{push_token}"]},
    "collision_preview": {"family": "collision", "phase": "read", "args": ["slug", "planned_paths", "repo_root?"], "mutates": false, "roles": ["coding", "config"], "argv": ["collision-preview", "{slug}", "{planned_paths}"]},
    "sync_batch_inventory": {"family": "sync_batch_inventory", "phase": "read", "args": [], "mutates": false, "roles": ["manager", "coding", "config"], "argv": ["sync-batch", "--inventory"]},
    "sync_batch_preview": {"family": "sync_batch", "phase": "preview", "args": ["repo_root", "repo_roots", "scope", "on_conflict"], "mutates": false, "roles": ["manager", "coding", "config"], "argv": ["sync-batch", "--scope", "{scope}", "--on-conflict", "{on_conflict}", "{repo_roots}"]},
    "sync_batch_apply": {"family": "sync_batch", "phase": "apply", "args": ["repo_root", "repo_roots", "scope", "on_conflict"], "mutates": true, "token": "preview", "roles": ["manager", "coding", "config"], "argv": ["sync-batch", "--scope", "{scope}", "--on-conflict", "{on_conflict}", "{repo_roots}", "--apply", "--preview-token", "{preview_token}"]},
    "sync_batch_push": {"family": "sync_batch", "phase": "push", "args": ["repo_root", "repo_roots", "scope", "on_conflict"], "mutates": true, "token": "push", "roles": ["manager", "coding", "config"], "argv": ["sync-batch", "--scope", "{scope}", "--on-conflict", "{on_conflict}", "{repo_roots}", "--push", "--push-token", "{push_token}"]},
    "repair_preview": {"family": "repair", "phase": "preview", "args": ["slug"], "mutates": false, "roles": ["repair"], "argv": ["repair", "{slug}"]},
    "repair_apply": {"family": "repair", "phase": "apply", "args": ["slug"], "mutates": true, "token": "preview", "roles": ["repair"], "argv": ["repair", "{slug}", "--apply", "--preview-token", "{preview_token}"]},
    "repair_push": {"family": "repair", "phase": "push", "args": ["slug"], "mutates": true, "token": "push", "roles": ["repair"], "argv": ["repair", "{slug}", "--push", "--push-token", "{push_token}"]},
    "cleanup_preview": {"family": "cleanup", "phase": "preview", "args": ["slug"], "mutates": false, "roles": ["cleanup"], "argv": ["cleanup", "{slug}"]},
    "cleanup_apply": {"family": "cleanup", "phase": "apply", "args": ["slug"], "mutates": true, "token": "preview", "roles": ["cleanup"], "argv": ["cleanup", "{slug}", "--apply", "--preview-token", "{preview_token}"]},
    "cleanup_push": {"family": "cleanup", "phase": "push", "args": ["slug"], "mutates": true, "token": "push", "roles": ["cleanup"], "argv": ["cleanup", "{slug}", "--push", "--push-token", "{push_token}"]},
    "group_refresh_preview": {"family": "group_refresh", "phase": "preview", "args": ["group_id"], "mutates": false, "roles": ["group_git"], "argv": ["group-refresh", "{group_id}"]},
    "group_refresh_apply": {"family": "group_refresh", "phase": "apply", "args": ["group_id"], "mutates": true, "token": "preview", "roles": ["group_git"], "argv": ["group-refresh", "{group_id}", "--apply", "--preview-token", "{preview_token}"]},
    "group_refresh_push": {"family": "group_refresh", "phase": "push", "args": ["group_id"], "mutates": true, "token": "push", "roles": ["group_git"], "argv": ["group-refresh", "{group_id}", "--push", "--push-token", "{push_token}"]},
    "group_finish_preview": {"family": "group_finish", "phase": "preview", "args": ["group_id"], "mutates": false, "roles": ["group_git"], "argv": ["group-finish", "{group_id}"]},
    "group_finish_apply": {"family": "group_finish", "phase": "apply", "args": ["group_id"], "mutates": true, "token": "preview", "roles": ["group_git"], "argv": ["group-finish", "{group_id}", "--apply", "--preview-token", "{preview_token}"]},
    "group_finish_push": {"family": "group_finish", "phase": "push", "args": ["group_id"], "mutates": true, "token": "push", "roles": ["group_git"], "argv": ["group-finish", "{group_id}", "--push", "--push-token", "{push_token}"]},
    "group_cleanup_preview": {"family": "group_cleanup", "phase": "preview", "args": ["group_id"], "mutates": false, "roles": ["cleanup"], "argv": ["group-cleanup", "{group_id}"]},
    "group_cleanup_apply": {"family": "group_cleanup", "phase": "apply", "args": ["group_id"], "mutates": true, "token": "preview", "roles": ["cleanup"], "argv": ["group-cleanup", "{group_id}", "--apply", "--preview-token", "{preview_token}"]},
    "group_cleanup_push": {"family": "group_cleanup", "phase": "push", "args": ["group_id"], "mutates": true, "token": "push", "roles": ["cleanup"], "argv": ["group-cleanup", "{group_id}", "--push", "--push-token", "{push_token}"]},
    "group_repair_preview": {"family": "group_repair", "phase": "preview", "args": ["group_id"], "mutates": false, "roles": ["repair"], "argv": ["group-repair", "{group_id}"]},
    "group_repair_apply": {"family": "group_repair", "phase": "apply", "args": ["group_id"], "mutates": true, "token": "preview", "roles": ["repair"], "argv": ["group-repair", "{group_id}", "--apply", "--preview-token", "{preview_token}"]},
    "group_repair_push": {"family": "group_repair", "phase": "push", "args": ["group_id"], "mutates": true, "token": "push", "roles": ["repair"], "argv": ["group-repair", "{group_id}", "--push", "--push-token", "{push_token}"]},
    "abandon_preview": {"family": "abandon", "phase": "preview", "args": ["slug"], "mutates": false, "roles": ["manager"], "argv": ["abandon", "{slug}"]}
  }
}
